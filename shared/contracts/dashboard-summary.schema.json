            "$ref": "#/$defs/WorkspaceRecordResponse"
          },
          "title": "Projects",
          "type": "array"
        },
        "alerts": {
          "items": {
            "type": "string"
          },
          "title": "Alerts",
          "type": "array"
        }
      },
      "required": [
        "viewer",
        "generated_at",
        "data_status",
        "disclaimer",
        "workspace",
        "counts",
        "work_items",
        "projects",
        "alerts"
