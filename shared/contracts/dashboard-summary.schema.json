    "CreativeDashboardResponse": {
      "additionalProperties": false,
      "properties": {
        "viewer": {
          "$ref": "#/$defs/ViewerResponse"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
