{
  "$defs": {
    "AdminCounts": {
      "properties": {
        "open_errors": {
          "minimum": 0,
          "title": "Open Errors",
          "type": "integer"
        },
        "pending_ai_feedback": {
          "minimum": 0,
          "title": "Pending Ai Feedback",
          "type": "integer"
        },
        "audit_events": {
          "minimum": 0,
          "title": "Audit Events",
          "type": "integer"
        }
      },
      "required": [
        "open_errors",
        "pending_ai_feedback",
        "audit_events"
      ],
      "title": "AdminCounts",
      "type": "object"
    },
    "AdminDashboardResponse": {
      "additionalProperties": false,
      "properties": {
        "viewer": {
          "$ref": "#/$defs/ViewerResponse"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "data_status": {
          "$ref": "#/$defs/DataStatus"
        },
        "disclaimer": {
          "title": "Disclaimer",
          "type": "string"
        },
        "workspace": {
          "const": "admin",
          "title": "Workspace",
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/AdminCounts"
        },
        "readable_modules": {
          "items": {
            "type": "string"
          },
          "title": "Readable Modules",
          "type": "array"
        },
        "alerts": {
          "items": {
            "type": "string"
          },
          "title": "Alerts",
          "type": "array"
        }
      },
      "required": [
        "viewer",
        "generated_at",
        "data_status",
        "disclaimer",
        "workspace",
        "counts",
        "readable_modules",
        "alerts"
      ],
      "title": "AdminDashboardResponse",
      "type": "object"
    },
    "CreativeCounts": {
      "properties": {
        "pending_content_tasks": {
