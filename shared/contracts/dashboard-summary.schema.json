      "type": "string"
    },
    "ViewerResponse": {
      "properties": {
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "username": {
          "title": "Username",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/RoleName"
          },
          "title": "Roles",
          "type": "array"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/ModuleCode"
