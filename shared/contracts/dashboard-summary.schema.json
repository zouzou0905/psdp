  "discriminator": {
    "mapping": {
      "admin": "#/$defs/AdminDashboardResponse",
      "creative": "#/$defs/CreativeDashboardResponse",
      "operations": "#/$defs/OperationsDashboardResponse",
      "procurement": "#/$defs/ProcurementDashboardResponse"
    },
    "propertyName": "workspace"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/OperationsDashboardResponse"
    },
    {
      "$ref": "#/$defs/ProcurementDashboardResponse"
    },
    {
      "$ref": "#/$defs/CreativeDashboardResponse"
    },
    {
      "$ref": "#/$defs/AdminDashboardResponse"
    }
  ]
}
