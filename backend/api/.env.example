APP_NAME=AI Product Operations Platform API
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://ai_product_ops_app:replace-with-url-encoded-password@127.0.0.1:5432/ai_product_ops_dev
TEST_DATABASE_URL=postgresql+asyncpg://ai_product_ops_app:replace-with-url-encoded-password@127.0.0.1:5432/ai_product_ops_test
RUN_POSTGRESQL_INTEGRATION_TESTS=0
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]
LOG_LEVEL=INFO
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_MINUTES=30
AUTH_ISSUER=ai-product-operations-platform
AUTH_AUDIENCE=ai-product-operations-api
AUTH_COOKIE_SAMESITE=lax
DEMO_OPERATIONS_PASSWORD=
DEMO_PROCUREMENT_PASSWORD=
DEMO_CREATIVE_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=5
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2
EXPORT_STORAGE_PATH=../../tmp/exports
EXPORT_FILE_TTL_HOURS=24
SELECTION_SKILL_ASSETS_PATH=../../ai/skills/amazon-selection
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

